---
import '../styles/global.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import { site } from '../data/site';
import { getImage } from 'astro:assets';
import instalacao from '../assets/fotos/instalacao-2026.jpg';

interface Props {
  titulo?: string;
  descricao?: string;
}

const { titulo, descricao = site.descricao } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${site.nome}` : `${site.nome} · Ritual de Emulação em São Paulo`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: instalacao, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogImagem = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#14325d" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Cabecalho />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main { flex: 1; }
  .pular {
    position: absolute;
    left: 1rem;
    top: -3rem;
    padding: 0.5rem 1rem;
    background: var(--azul);
    color: #fff;
    border-radius: var(--raio);
    z-index: 100;
  }
  .pular:focus { top: 1rem; }
</style>
