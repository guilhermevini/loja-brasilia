---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Ornamento, { type TipoOrnamento } from './Ornamento.astro';

interface Props {
  sobretitulo: string;
  titulo: string;
  lead?: string;
  ornamento?: TipoOrnamento;
  foto?: ImageMetadata;
  legendaFoto?: string;
}

const { sobretitulo, titulo, lead, ornamento, foto, legendaFoto } = Astro.props;
---

<section class:list={['topo', foto && 'com-foto']}>
  {
    foto && (
      <Image
        src={foto}
        alt=""
        class="fundo"
        width={2560}
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  {!foto && ornamento && <Ornamento tipo={ornamento} class="desenho" />}
  <div class="container revelar">
    <span class="sobretitulo">{sobretitulo}</span>
    <h1>{titulo}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
  {foto && legendaFoto && <p class="legenda container">{legendaFoto}</p>}
</section>

<style>
  .topo {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7rem) clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--linha);
    background: linear-gradient(180deg, var(--fundo-alt), var(--fundo));
  }
  .topo > .container { position: relative; }
  h1 { max-width: 46rem; }
  .lead { max-width: 40rem; margin-bottom: 0; }

  .topo :global(.desenho) {
    position: absolute;
    top: 50%;
    right: max(-4rem, calc((100vw - var(--largura)) / 2 - 2rem));
    width: clamp(18rem, 34vw, 28rem);
    aspect-ratio: 1;
    transform: translateY(-50%);
    opacity: 0.13;
    animation: surgir 1.4s var(--ease) both;
  }
  @keyframes surgir {
    from { opacity: 0; transform: translateY(-48%) scale(0.98); }
  }

  /* Variante com foto de fundo */
  .com-foto {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(26rem, 55vh, 36rem);
    border-bottom: 0;
    background: var(--azul-escuro);
  }
  .com-foto::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgb(13 35 66 / 0.92) 0%, rgb(13 35 66 / 0.7) 45%, rgb(13 35 66 / 0.25) 100%),
      linear-gradient(0deg, rgb(13 35 66 / 0.6) 0%, transparent 50%);
  }
  .com-foto > .container,
  .com-foto > .legenda { z-index: 2; width: 100%; }
  .com-foto :global(.fundo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: aproximar 2.4s var(--ease) both;
  }
  @keyframes aproximar {
    from { transform: scale(1.06); }
    to { transform: scale(1); }
  }
  .com-foto h1 { color: #fff; }
  .com-foto .lead { color: rgb(255 255 255 / 0.85); }
  .legenda {
    position: relative;
    margin-top: 2rem;
    margin-bottom: 0;
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.55);
    text-align: right;
  }

  @media (max-width: 48rem) {
    .topo :global(.desenho) { right: -6rem; opacity: 0.07; }
    .com-foto::before {
      background: linear-gradient(0deg, rgb(13 35 66 / 0.95) 0%, rgb(13 35 66 / 0.7) 60%, rgb(13 35 66 / 0.5) 100%);
    }
    .legenda { text-align: left; }
  }
</style>
